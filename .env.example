# =============================================
# SGH ERP — Frontend Environment Variables (Vite)
# Copy this file to .env for local dev.
# On Vercel, set these in Project Settings → Environment Variables.
# Only VITE_* vars are exposed to the browser — never put secrets here.
# =============================================

# REST API base (v1). Include the /api/v1 suffix.
VITE_API_URL=http://localhost:5000/api/v1

# v2 API base (used by src/v2/lib/api.js). Suffix /v2 is appended in code.
VITE_API_BASE_URL=/api

# Base URL for uploaded files/images. Include the /uploads suffix.
VITE_UPLOAD_URL=http://localhost:5000/uploads

# App display name
VITE_APP_NAME=SGH ERP
